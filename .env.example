# Copy to .env and fill locally. NEVER commit .env.
# This file lists variable NAMES only. Keep the ones your architecture actually uses
# (see 10-DOCS/ARCHITECTURE.md) and delete the others.
#
# Public (exposed to the browser — treat as public information)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
#
# Server-only (never prefix with VITE_ / NEXT_PUBLIC_, never import in frontend code)
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=
# WEBHOOK_SIGNING_SECRET=
