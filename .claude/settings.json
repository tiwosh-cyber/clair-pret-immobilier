{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "denyRead": [
        "./.env",
        "./.env.local",
        "./.env.development",
        "./.env.production",
        "./.env.test"
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "*.npmjs.org",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/garde-fou.cjs\"; command -v node >/dev/null 2>&1 || { echo \"Garde-fou : Node.js introuvable, action bloquée. Installe Node.js puis relance Claude Code.\" >&2; exit 2; }; [ -f \"$f\" ] || { echo \"Garde-fou : script de sécurité absent, action bloquée.\" >&2; exit 2; }; node \"$f\"; rc=$?; [ \"$rc\" -eq 0 ] || [ \"$rc\" -eq 2 ] || { echo \"Garde-fou : échec inattendu (code $rc), action bloquée par prudence.\" >&2; exit 2; }; exit $rc"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/service-account*.json)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.development)",
      "Edit(.env.production)",
      "Edit(.env.test)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/11-SCRIPTS/checks/test-garde-fou.cjs)",
      "Edit(/.claude/agents/security-reviewer.md)",
      "Edit(/.claude/settings.local.json)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(supabase db push *)",
      "Bash(supabase db reset *)",
      "Bash(vercel --prod *)",
      "Bash(npx vercel --prod *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ],
    "ask": [
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git checkout -- *)",
      "Bash(rm *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)",
      "Bash(supabase migration *)",
      "Bash(supabase link *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(netlify *)",
      "Bash(npx netlify *)",
      "Bash(supabase functions *)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch)",
      "Bash(git switch *)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm run test *)",
      "Bash(npm audit)"
    ]
  }
}
